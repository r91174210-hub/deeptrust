# Copy to .env and fill in — never commit the real .env file.

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=deeptrust
DB_USERNAME=deeptrust_app
DB_PASSWORD=

# --- JWT ---
# Generate with: openssl rand -base64 64
JWT_SECRET=

# --- ROOT founder account bootstrap (one-time, forced rotation on first login) ---
DEEPTRUST_ROOT_USERNAME=
DEEPTRUST_ROOT_EMAIL=
DEEPTRUST_ROOT_INITIAL_PASSWORD=

# --- AI microservice ---
AI_SERVICE_BASE_URL=http://localhost:8000

# --- Blockchain ---
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_WALLET_PRIVATE_KEY=
DEEPTRUST_CONTRACT_ADDRESS=

# --- Public verification / QR ---
PUBLIC_VERIFY_BASE_URL=http://localhost:5173/verify

# --- Zero-knowledge proofs ---
ZK_CIRCUIT_BUILD_DIR=./zk-circuits/build
SNARKJS_PATH=snarkjs
